{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "liza-portal-cleanup",
  "main": "cleanup-worker.mjs",
  "compatibility_date": "2026-10-07",
  "account_id": "0d62599be18e03f3b8d92dd0a2081250",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "liza-customer-portal",
    "database_id": "d0609db8-34b4-4bc5-822a-cfa9167bb6dd"
  }],
  "r2_buckets": [{
    "binding": "PHOTOS",
    "bucket_name": "liza-memories-gallerie",
    "jurisdiction": "eu"
  }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
